# AI Studio Environment Configuration

# API 1: The Brain (Chat, Story Memory, Screenplay & Split Harmonizer)
# Provider: Google AI Studio (Gemini 3.8 Flash)
# Get your API key: https://aistudio.google.com/apikey
# In Google AI Studio Build, this is automatically injected into the server environment.
GEMINI_API_KEY=

# API 2: The Video Engine (3-5s Neural Video Clip Generation)
# Provider: Fal.ai (Wan-2.1 / LTX-Video)
# Get your API key: https://fal.ai/dashboard/keys
FAL_KEY=
